# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=gnc_user
DB_PASSWORD=gnc_password
DB_DATABASE=gnc_workshop

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gnc-workshop-docs
MINIO_USE_SSL=false

# Backend
APP_KEY=change-me-to-a-secure-random-string
APP_NAME=GNC Workshop API
APP_URL=http://localhost:3333
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:3333/api/v1

