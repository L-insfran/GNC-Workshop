# Backend environment variables
# Copy to .env and adjust for your environment (local / VM)

DB_HOST=localhost
DB_PORT=5432
DB_USER=gnc_user
DB_PASSWORD=gnc_password
DB_DATABASE=gnc_workshop

REDIS_HOST=localhost
REDIS_PORT=6379

APP_KEY=change-me-to-a-secure-random-string-min-32-chars
APP_NAME=GNC Workshop API
APP_URL=http://localhost:3333
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Notificaciones a clientes (vencimientos oblea/PH)
# manual = UI asistida wa.me/mailto ($0) | whatsapp_cloud = Meta API (futuro)
NOTIFICACION_DRIVER=manual
TALLER_NOMBRE=GNC Workshop
