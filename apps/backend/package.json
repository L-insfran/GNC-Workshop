{
  "name": "@gnc/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GNC Workshop Management System - Backend API",
  "scripts": {
    "dev": "node --import tsx bin/server.ts",
    "build": "node ace.js build",
    "start": "node bin/server.js",
    "test": "node --import tsx bin/test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migration:run": "node ace.js migration:run",
    "migration:rollback": "node ace.js migration:rollback",
    "db:seed": "node ace.js db:seed",
    "vencimientos:alertar": "node ace.js vencimientos:alertar"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#modules/*": "./app/modules/*.js",
    "#shared/*": "./app/shared/*.js",
    "#commands/*": "./commands/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.3.0",
    "@adonisjs/bouncer": "^3.1.4",
    "@adonisjs/core": "^6.16.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.5.0",
  "@gnc/shared-types": "*",
    "@vinejs/vine": "^3.0.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.0.0",
    "@japa/assert": "^4.0.0",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.0.0",
    "@types/luxon": "^3.4.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
