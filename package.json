{
  "name": "gnc-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "GNC Workshop Management System - ERP para talleres de GNC",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev -w @gnc/backend",
    "dev:frontend": "npm run dev -w @gnc/frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
